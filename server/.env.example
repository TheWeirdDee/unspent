# BACKEND (API + relayer). Copy to server/.env. This file holds secrets: never commit it, never expose it to Vite.
NETWORK=testnet
PORT=3001

# Relayer key: pays gas only; it cannot change signed amounts or destinations. Use a dedicated low-balance wallet.
TESTNET_RELAYER_KEY=
MAINNET_RELAYER_KEY=

# Model provider (Google Gemini via its OpenAI-compatible endpoint). The API appends /chat/completions itself.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=
LLM_DAILY_GLOBAL_LIMIT=100
LLM_DAILY_PER_CUSTOMER_LIMIT=10
LLM_TIMEOUT_MS=30000

# Operator token for the simulated-outage demo toggle.
DEMO_OPERATOR_TOKEN=

# Durable metadata (production): Postgres connection string, e.g. a Neon free-tier database. Empty = local JSON file in data/.
DATABASE_URL=

# Browser origins allowed to call the API cross-origin, comma separated (e.g. https://your-app.netlify.app). Empty = same-origin only.
CORS_ORIGINS=

# Test scripts only (Arc Testnet throwaway keys; created by `bun run gen:testnet-keys`). Never reuse for mainnet.
TESTNET_CUSTOMER_KEY=
TESTNET_PROVIDER_OWNER_KEY=
TESTNET_PAYOUT_KEY=
