# FRONTEND (Vite). Copy to .env in the repo root. PUBLIC values only: everything here is bundled into the browser.
# NEVER put API keys, private keys or tokens in any VITE_* variable.
VITE_NETWORK=testnet
# Base URL of the deployed API when it is on a different origin (leave empty in local dev; Vite proxies /api).
VITE_API_BASE=
# URL of your hosted independent recovery client (leave empty to use the local /recovery-client/ proxy).
VITE_RECOVERY_URL=
# Arc Studio project URLs shown on /proof (leave empty if none).
VITE_STUDIO_URL=
VITE_STUDIO_SHARE_URL=
